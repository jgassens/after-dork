<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Ported Swift keeps its own naming; unused-field noise isn't useful here. -->
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CA1416</NoWarn>
    <Version>1.2.1</Version>
    <Company>Gassensmith Lab</Company>
    <Product>After Dork</Product>
    <Copyright>© 1996, emotionally</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SkiaVersion>3.119.4</SkiaVersion>
  </PropertyGroup>
</Project>
